diff --git a/manifests/home/light-controller.yaml b/manifests/home/light-controller.yaml
--- a/manifests/home/light-controller.yaml
+++ b/manifests/home/light-controller.yaml
@@ -6,18 +6,25 @@
   labels: {app: light-controller}
 spec:
   replicas: 1
-  strategy: {type: Recreate}
+  strategy:
+    type: RollingUpdate
+    rollingUpdate: {maxSurge: 1, maxUnavailable: 0}
   selector:
     matchLabels: {app: light-controller}
   template:
     metadata:
       labels: {app: light-controller}
     spec:
+      # Keep one writer: the switch is a press-mode toggle.
+      affinity:
+        podAntiAffinity:
+          requiredDuringSchedulingIgnoredDuringExecution:
+            - labelSelector:
+                matchLabels: {app: light-controller}
+              topologyKey: kubernetes.io/hostname
       nodeSelector:
         kubernetes.io/arch: arm64
       automountServiceAccountToken: false
-      imagePullSecrets:
-        - name: registry-pull
       securityContext:
         runAsNonRoot: true
         runAsUser: 10001
